# Copy to .env (git-ignored) and export before running the backend locally:
#   set -a; source .env; set +a; (cd backend && ./mvnw -pl salary-app spring-boot:run)
BOOTSTRAP_MANAGER_USERNAME=hr.manager
BOOTSTRAP_MANAGER_PASSWORD=choose-a-long-local-password
BOOTSTRAP_ANALYST_USERNAME=hr.analyst
BOOTSTRAP_ANALYST_PASSWORD=choose-another-long-password
SEED_ENABLED=true
# Optional, local only:
API_DOCS_ENABLED=true
