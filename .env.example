# Copy to .env (git-ignored) and choose your own values.
#
# Full release (Docker only):    docker compose -f compose.release.yml up -d --build
# Backend from source instead:   set -a; source .env; set +a; (cd backend && ./mvnw -pl salary-app spring-boot:run)
#
# Passwords: at least 12 characters (the app refuses to start otherwise).
POSTGRES_PASSWORD=choose-a-database-password
BOOTSTRAP_MANAGER_USERNAME=hr.manager
BOOTSTRAP_MANAGER_PASSWORD=choose-a-long-local-password
BOOTSTRAP_ANALYST_USERNAME=hr.analyst
BOOTSTRAP_ANALYST_PASSWORD=choose-another-long-password
SEED_ENABLED=true
# Optional, local only:
API_DOCS_ENABLED=true
