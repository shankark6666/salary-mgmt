# ACME Salary UI. Serves the Angular build and proxies /api to the backend on the same origin,
# so session and CSRF cookies stay first-party and the API needs no CORS policy (ADR-0006).
# ${BACKEND_URL} is filled in at container start; nginx variables ($request_id …) are not.

server {
    listen 3000;
    server_tokens off;
    root /usr/share/nginx/html;

    client_max_body_size 64k;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # CSV exports stream row by row; pass them through as they arrive.
        proxy_buffering off;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Hashed build output: cache forever.
    location ~* \.(?:js|css|woff2?|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    # The app shell. A fresh nonce per response ($request_id: 128 random bits) goes into both
    # the CSP header and the page; Angular stamps it on its scripts and every <style> it adds.
    location / {
        try_files $uri /index.html;
        sub_filter_types text/html;
        sub_filter_once off;
        sub_filter "__CSP_NONCE__" "$request_id";
        add_header Cache-Control "no-store" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'nonce-$request_id' 'strict-dynamic'; style-src 'self' 'nonce-$request_id'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
